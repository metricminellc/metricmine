{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/metricminellc/metricmine/main/docs/spec/engine/mapping-contract.schema.json",
  "title": "MetricMine mapping contract",
  "description": "Machine-readable half of docs/spec/engine.md section 2. Validates a parsed mapping-contract YAML document: the auto-modeling engine's input, and the gold mapping proposer's structured-output schema in Phase 6 (D-21). Every mapping element is first-class; customProperties carry provenance and rationale only.",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "name", "version", "status", "schema", "customProperties"],
  "properties": {
    "apiVersion": { "const": "v3.1.0" },
    "kind": { "const": "DataContract" },
    "id": {
      "type": "string",
      "pattern": "^gold_[a-z][a-z0-9_]*_mapping$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": { "enum": ["draft", "active"] },
    "schema": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "customProperties": {
      "type": "array",
      "items": { "$ref": "#/$defs/customProperty" },
      "allOf": [
        {
          "contains": {
            "properties": {
              "property": { "const": "proposedBy" },
              "value": { "enum": ["human", "gold-mapping-proposer"] }
            },
            "required": ["property", "value"]
          },
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "property": { "const": "profileHash" },
              "value": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            },
            "required": ["property", "value"]
          },
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "property": { "const": "proposedAt" },
              "value": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" }
            },
            "required": ["property", "value"]
          },
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "categoryName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "allOf": [
        { "not": { "pattern": "^(dim_|fact_|vw_|silver_|bronze_|stg_)" } },
        { "not": { "const": "context_registry" } }
      ]
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "category": {
      "type": "object",
      "required": ["name", "logicalType", "physicalType", "entityGroup", "sourceTable", "timeColumn", "timeGrain", "grain", "properties"],
      "properties": {
        "name": { "$ref": "#/$defs/categoryName" },
        "logicalType": { "const": "object" },
        "physicalType": { "const": "mapping" },
        "description": { "type": "string" },
        "entityGroup": { "$ref": "#/$defs/fieldName" },
        "sourceTable": {
          "type": "string",
          "pattern": "^silver\\.[a-z][a-z0-9_]*$"
        },
        "timeColumn": { "$ref": "#/$defs/fieldName" },
        "timeGrain": {
          "enum": ["minute", "hour", "day", "week", "month", "quarter", "year"]
        },
        "grain": { "$ref": "#/$defs/grain" },
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" },
          "contains": {
            "type": "object",
            "properties": { "mappingRole": { "const": "time" } },
            "required": ["mappingRole"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        "quality": false
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "logicalType", "physicalType", "required", "mappingRole"],
      "properties": {
        "name": { "$ref": "#/$defs/fieldName" },
        "logicalType": {
          "enum": ["string", "integer", "number", "boolean", "date"]
        },
        "physicalType": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "mappingRole": { "enum": ["dimension", "measure", "time"] },
        "description": { "type": "string" },
        "quality": false
      }
    },
    "grain": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "degenerateIdentifiers"],
          "properties": {
            "type": { "const": "transaction" },
            "degenerateIdentifiers": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/degenerateIdentifier" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "aggregations"],
          "properties": {
            "type": { "const": "aggregated" },
            "aggregations": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
              "additionalProperties": { "enum": ["sum", "min", "max", "avg", "count"] }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "degenerateIdentifier": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source", "name"],
          "properties": {
            "source": { "const": "column" },
            "name": { "$ref": "#/$defs/fieldName" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["source", "name", "derivation", "of"],
          "properties": {
            "source": { "const": "derived" },
            "name": { "$ref": "#/$defs/fieldName" },
            "derivation": { "const": "canonical-key-v2" },
            "of": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/fieldName" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "customProperty": {
      "type": "object",
      "required": ["property", "value"],
      "properties": {
        "property": { "type": "string", "minLength": 1 },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": { "property": { "const": "proposedBy" } },
            "required": ["property"]
          },
          "then": {
            "properties": { "value": { "enum": ["human", "gold-mapping-proposer"] } }
          }
        },
        {
          "if": {
            "properties": { "property": { "const": "profileHash" } },
            "required": ["property"]
          },
          "then": {
            "properties": { "value": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
          }
        },
        {
          "if": {
            "properties": { "property": { "const": "proposedAt" } },
            "required": ["property"]
          },
          "then": {
            "properties": { "value": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" } }
          }
        }
      ]
    }
  }
}
