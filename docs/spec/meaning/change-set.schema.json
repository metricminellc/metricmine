{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metricmine.ai/spec/meaning/change-set.schema.json",
  "title": "MetricMine governed meaning change set (D-44)",
  "description": "A context proposal: a declared change set a person runs through `python -m metricmine.meaning propose <file>`. The vocabulary is closed: the glossary's nine kinds, the ontology's seven, and governed documents' five (D-44; Amendment AD). Every check a schema cannot express (a row the register carries, a label owned elsewhere, a drop while a binding stands, a parent cycle, a quote in a committed copy, a person as `by`) runs in code, in order, against a working copy of the registers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "by",
    "intent",
    "changes"
  ],
  "properties": {
    "by": {
      "type": "string",
      "minLength": 1,
      "description": "The person's name; an agent or a model name is refused."
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "description": "The person's words, verbatim; recorded and hashed, and carried by every binding this set makes or re-binds."
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "add_term",
              "amend_definition",
              "rename_term",
              "add_synonym",
              "remove_synonym",
              "deprecate_term",
              "drop_term",
              "bind",
              "unbind",
              "add_concept",
              "amend_concept",
              "relabel",
              "deprecate_concept",
              "drop_concept",
              "bind_concept",
              "unbind_concept",
              "add_document",
              "bind_document",
              "unbind_document",
              "recertify_document",
              "retire_document"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "term_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "term": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "synonyms": {
            "type": [
              "string",
              "null"
            ],
            "description": "Other names, separated by '; '."
          },
          "synonym": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "review_by": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "superseded_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "concept_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "contract_id": {
            "type": "string",
            "minLength": 1
          },
          "column_name": {
            "type": "string",
            "description": "The column, or the empty string for the table."
          },
          "document_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "description": "The stable id of a governed document (D-43)."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "governance": {
            "type": "string",
            "enum": [
              "in_repo",
              "platform_governed",
              "pinned"
            ]
          },
          "access": {
            "type": "string",
            "enum": [
              "in_repo",
              "public",
              "local_path",
              "pointer_only"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "description": "A repository-relative path for in_repo; a display link otherwise. Never opened here unless in_repo."
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "certification_source": {
            "type": "string",
            "enum": [
              "git_merge",
              "platform_approval",
              "steward_attestation",
              "none"
            ]
          },
          "gate_strength": {
            "type": "string",
            "enum": [
              "publication_gate",
              "attestation_badge",
              "none"
            ]
          },
          "durable_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "approver_role": {
            "type": [
              "string",
              "null"
            ]
          },
          "pinned_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "upstream_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "upstream_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "text_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$",
            "description": "Declared for a public or pointer_only document; measured from the committed copy, never declared, for in_repo."
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "description": "The verbatim quote the contract's sentence rests on; checked against the committed copy."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "add_term"
                }
              }
            },
            "then": {
              "required": [
                "term_id",
                "term",
                "definition",
                "owner"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "amend_definition"
                }
              }
            },
            "then": {
              "required": [
                "term_id",
                "definition"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "rename_term"
                }
              }
            },
            "then": {
              "required": [
                "term_id",
                "term"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "add_synonym"
                }
              }
            },
            "then": {
              "required": [
                "term_id",
                "synonym"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "remove_synonym"
                }
              }
            },
            "then": {
              "required": [
                "term_id",
                "synonym"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "deprecate_term"
                }
              }
            },
            "then": {
              "required": [
                "term_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "drop_term"
                }
              }
            },
            "then": {
              "required": [
                "term_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "bind"
                }
              }
            },
            "then": {
              "required": [
                "term_id",
                "contract_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "unbind"
                }
              }
            },
            "then": {
              "required": [
                "term_id",
                "contract_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "add_concept"
                }
              }
            },
            "then": {
              "required": [
                "concept_id",
                "label",
                "definition",
                "owner"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "amend_concept"
                }
              }
            },
            "then": {
              "required": [
                "concept_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "relabel"
                }
              }
            },
            "then": {
              "required": [
                "concept_id",
                "label"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "deprecate_concept"
                }
              }
            },
            "then": {
              "required": [
                "concept_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "drop_concept"
                }
              }
            },
            "then": {
              "required": [
                "concept_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "bind_concept"
                }
              }
            },
            "then": {
              "required": [
                "concept_id",
                "contract_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "unbind_concept"
                }
              }
            },
            "then": {
              "required": [
                "concept_id",
                "contract_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "add_document"
                }
              }
            },
            "then": {
              "required": [
                "document_id",
                "title",
                "governance",
                "access",
                "location",
                "format",
                "certification_source",
                "gate_strength"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "bind_document"
                }
              }
            },
            "then": {
              "required": [
                "document_id",
                "contract_id",
                "column_name",
                "anchor"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "unbind_document"
                }
              }
            },
            "then": {
              "required": [
                "document_id",
                "contract_id",
                "column_name"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "recertify_document"
                }
              }
            },
            "then": {
              "required": [
                "document_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "retire_document"
                }
              }
            },
            "then": {
              "required": [
                "document_id"
              ]
            }
          }
        ]
      }
    }
  }
}
